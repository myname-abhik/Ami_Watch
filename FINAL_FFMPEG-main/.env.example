PORT=3000
# MEGA account (note: "USER" clashes with the OS USER variable on Linux/macOS — see README note)
USER=your-mega-email
PASSWORD=your-mega-password
FILENAME=

# Admin panel login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
# long random string used to sign login tokens (keeps sessions valid across restarts)
ADMIN_SECRET=replace-with-a-long-random-string
